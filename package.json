{
  "name": "ridemate",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@ridemate/web...",
    "lint": "turbo run lint",
    "lint:ws": "sherif",
    "check-types": "turbo run check-types",
    "format": "prettier --check . --cache",
    "format:fix": "prettier --write . --cache",
    "prepare": "husky",
    "ui-add": "pnpm --filter @ridemate/ui ui-add",
    "db:generate": "pnpm --filter @ridemate/db generate",
    "db:migrate": "pnpm --filter @ridemate/db migrate",
    "db:push": "pnpm --filter @ridemate/db push",
    "db:studio": "pnpm --filter @ridemate/db studio",
    "auth:generate": "pnpm --filter @ridemate/auth generate",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "prettier": "@ridemate/prettier-config",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@ridemate/prettier-config": "workspace:*",
    "@turbo/gen": "^2.11.10",
    "@types/node": "catalog:",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "catalog:",
    "sherif": "^1.13.0",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
