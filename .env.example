NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local: docker Postgres 18
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=raahi
POSTGRES_PORT=5432
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/raahi

# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Google OAuth: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

EXPO_PUBLIC_SERVER_URL="http://localhost:3000"

# Android Maps SDK key, the server Places/Routes key, and an optional Maps JS key.
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_WEB_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_WEBVIEW=0
RIDE_ROUTE_CORRIDOR_METERS=500
RIDE_PICKUP_WINDOW_MINUTES=30
